# ==================================
# Motion Transfer Studio - Environment Variables
# ==================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit your .env file to version control!

# ==================================
# OpenRouter Configuration (the only provider)
# ==================================
# Get your API key from: https://openrouter.ai/keys
#
# IMPORTANT: paste the key as a bare value - no quotes, no spaces.
#   OPENROUTER_API_KEY=sk-or-v1-...
# A quoted or padded value is rejected on startup with a clear error.
#
# The key is read server-side only (api/openrouter.ts and server.js) and is
# never sent to the browser. That is why it has no VITE_ prefix.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional attribution headers sent with every request
OPENROUTER_SITE_URL=https://your-app.example.com
OPENROUTER_APP_NAME=Motion Transfer Studio

# Proxy base URL used by the frontend.
# The app and proxy run in one process, so this is normally left as-is.
VITE_OPENROUTER_API_BASE_URL=/api/openrouter

# ==================================
# Public HTTPS origin (needed for exact motion transfer)
# ==================================
# OpenRouter requires the driver video to be referenced as a public HTTPS
# URL. It rejects base64 data URLs for video (images accept them), and the
# OpenRouter Files API does not accept MP4 either.
#
# Leave this unset and the app samples your video into key frames, which
# approximates motion instead of transferring it exactly.
#
# Dev:  cloudflared tunnel --url http://localhost:8080
#       PUBLIC_URL=https://<your-tunnel-host>
# Prod: PUBLIC_URL=https://your-deployed-domain
# PUBLIC_URL=https://your-tunnel-host

# ==================================
# Notes
# ==================================
# 1. No account or database required. Files stay in the browser's IndexedDB.
# 2. Local limits: avatar image 10MB, driver video 20MB.
# 3. Default clip length is 10 seconds.